# Copy to .env.local and fill in. .env.local is git-ignored.

# Google Maps JavaScript API key (enable "Maps JavaScript API" in your GCP project).
# Leave empty to fall back to the built-in schematic map.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID from Google Cloud console > Map Management. DEMO_MAP_ID works for development.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Tract heat-risk API (../api), e.g. your Cloud Run URL. Leave empty in dev: Vite proxies /api
# to localhost:8080. If the API is unreachable the map falls back to the bundled sample data.
VITE_API_URL=
# City label in heat_observations for the metrics ribbon, and its time zone for the peak time.
VITE_LIVE_CITY=Chicago
VITE_LIVE_CITY_TZ=America/Chicago

# ADK agent server, e.g. http://localhost:8000 (adk api_server) or your Cloud Run URL.
# Leave empty to use the built-in mock agent.
VITE_AGENT_URL=
# The ADK app name (the agent folder name).
VITE_AGENT_APP_NAME=heat_agent
